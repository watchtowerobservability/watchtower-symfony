{
  "name": "watchtowerobservability/symfony",
  "description": "Watchtower for Symfony: exception subscriber, Messenger, Doctrine and Monolog integrations",
  "license": "Apache-2.0",
  "type": "symfony-bundle",
  "require": {
    "php": ">=8.1",
    "watchtowerobservability/sdk": "*",
    "open-telemetry/api": "^1.0",
    "symfony/http-kernel": "^6.4||^7.0",
    "symfony/dependency-injection": "^6.4||^7.0",
    "symfony/config": "^6.4||^7.0"
  },
  "require-dev": {
    "doctrine/dbal": "^4.0",
    "monolog/monolog": "^3.0",
    "phpunit/phpunit": "^10.5||^11.0",
    "symfony/messenger": "^6.4||^7.0"
  },
  "suggest": {
    "doctrine/dbal": "^4.0 for query spans",
    "symfony/messenger": "for message handling spans",
    "monolog/monolog": "^3.0 for the log handler"
  },
  "repositories": [
    { "type": "vcs", "url": "https://github.com/watchtowerobservability/watchtower-php" }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": { "psr-4": { "Watchtower\\Symfony\\": "src/" } },
  "autoload-dev": { "psr-4": { "Watchtower\\Symfony\\Tests\\": "tests/" } }
}
