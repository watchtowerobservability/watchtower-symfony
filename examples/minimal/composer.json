{
  "require": {
    "watchtowerobservability/symfony": "*",
    "symfony/framework-bundle": "^7.0",
    "symfony/runtime": "^7.0"
  },
  "repositories": [
    { "type": "path", "url": "../.." },
    { "type": "vcs", "url": "https://github.com/watchtowerobservability/watchtower-php" }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": { "allow-plugins": { "symfony/runtime": true } },
  "autoload": { "psr-4": { "App\\": "src/" } }
}
